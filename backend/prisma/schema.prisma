generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")          // pooled (PgBouncer), for app traffic
  directUrl = env("DATABASE_URL_UNPOOLED") // direct, for db push / migrations
}

model User {
  id              String   @id @default(cuid())
  privyUserId     String   @unique
  wallet          String   @unique
  whitelistedRoot String?
  verifiedUntil   DateTime?
  gasTopupTx      String?
  timezone        String   @default("UTC")
  course          String   @default("fr")
  onboardedAt     DateTime?
  username        String?  @unique // lowercase, 3-20 chars
  displayName     String?
  bio             String?
  hasAvatar       Boolean  @default(false)
  avatarVersion   Int      @default(0) // bumped on every change so image URLs can be cached forever
  streakFreezes   Int      @default(0) // banked freezes, earned at streak milestones, auto-spent to cover one missed day
  flagged         Boolean  @default(false) // set when an AbuseFlag is raised; reviewed manually, does not block learning
  createdAt       DateTime @default(now())

  ubiClaims       UbiClaim[]
  attempts        LessonAttempt[]
  streakDays      StreakDay[]
  stakes          Stake[]
  leagueMemberships LeagueMembership[]
  abuseFlags      AbuseFlag[]
  avatar          Avatar?

  @@map("users")
}

model UbiClaim {
  id        String   @id @default(cuid())
  userId    String
  txHash    String   @unique
  amount    String
  claimedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, claimedAt])
  @@map("ubi_claims")
}

model LessonAttempt {
  id         String   @id @default(cuid())
  userId     String
  lessonId   String
  kind       String   @default("lesson") // lesson | checkpoint
  score      Float
  durationS  Int
  passed     Boolean
  localDate  String   // YYYY-MM-DD in the user's timezone
  startKey   String?  @unique // userId:targetId:startedAt, blocks replaying one start token
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId, localDate])
  @@map("lesson_attempts")
}

model StreakDay {
  id      String  @id @default(cuid())
  userId  String
  date    String  // YYYY-MM-DD in the user's timezone
  frozen  Boolean @default(false) // backfilled by a streak freeze instead of an actual lesson pass
  user    User    @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@map("streak_days")
}

model Voucher {
  id        String   @id @default(cuid())
  root      String
  amount    String   // wei, as a decimal string
  nonce     String   @unique
  expiry    Int      // unix seconds
  reason    String   // lesson | checkpoint | league
  sourceId  String   @unique // attempt id that earned it
  signature String
  status    String   @default("issued") // issued | claimed | expired
  createdAt DateTime @default(now())

  @@index([root, status])
  @@map("vouchers")
}

model Cohort {
  id        Int      @id // matches the on-chain cohortId
  lengthDays Int     @default(7)
  startAt   DateTime
  endAt     DateTime
  minStake  String
  maxStake  String
  status    String   @default("open") // open | running | ended | settled
  stakes    Stake[]

  @@map("cohorts")
}

model Stake {
  id             String  @id @default(cuid())
  cohortId       Int
  userId         String
  amountReceived String
  txHash         String?
  finished       Boolean @default(false)
  withdrawn      Boolean @default(false)
  cohort         Cohort  @relation(fields: [cohortId], references: [id])
  user           User    @relation(fields: [userId], references: [id])

  @@unique([cohortId, userId])
  @@map("stakes")
}

model LeagueMembership {
  id         String  @id @default(cuid())
  userId     String
  weekKey    String  // ISO week, Monday-start UTC, e.g. "2026-W45"
  groupIndex Int     // which ~30-person group within that week
  user       User    @relation(fields: [userId], references: [id])

  @@unique([userId, weekKey])
  @@index([weekKey, groupIndex])
  @@map("league_memberships")
}

model LeagueBonus {
  id         String   @id @default(cuid())
  userId     String
  weekKey    String
  groupIndex Int
  rank       Int      // 1, 2 or 3
  amount     String   // wei
  settledAt  DateTime @default(now())

  @@unique([userId, weekKey])
  @@map("league_bonuses")
}

model AbuseFlag {
  id        String   @id @default(cuid())
  userId    String
  attemptId String
  reason    String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, resolved])
  @@map("abuse_flags")
}

/// Profile photo, kept out of `users` so every auth lookup does not drag image bytes along.
model Avatar {
  userId    String   @id
  data      Bytes
  type      String   // image/jpeg | image/png | image/webp
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("avatars")
}
