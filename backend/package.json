{
  "name": "@learnit/backend",
  "private": true,
  "version": "0.1.0",
  "description": "Server logic for LearnIt: auth, grading, streaks, vouchers, cohorts, Prisma schema, content, scripts.",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "content": "tsx scripts/build-content.ts",
    "prisma:generate": "prisma generate",
    "db:push": "dotenv -e ../.env -- prisma db push",
    "db:studio": "dotenv -e ../.env -- prisma studio",
    "neon:check": "tsx --env-file=../.env scripts/neon-check.mts",
    "cohort:finalize": "tsx --env-file=../.env scripts/finalize-cohort.mts",
    "league:finalize": "tsx --env-file=../.env scripts/finalize-league.mts"
  },
  "prisma": { "schema": "prisma/schema.prisma" },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@privy-io/server-auth": "^1.32.5",
    "viem": "2.57.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "dotenv-cli": "^7.4.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^2.1.0"
  }
}
